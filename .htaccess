<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # install 目录直接放行
  RewriteRule ^install/ - [L]

  # API — PHP 文件直接执行，无后缀路径路由到 .php
  RewriteRule ^api/.+\.php$ - [L]
  RewriteRule ^api/me$ api/me.php [L,QSA]
  RewriteRule ^api/favorites$ api/favorites.php [L,QSA]
  RewriteRule ^api/auth$ api/auth.php [L,QSA]
  RewriteRule ^api/admin/users$ api/admin/users.php [L,QSA]
  RewriteRule ^api/admin/metrics$ api/admin/metrics.php [L,QSA]
  RewriteRule ^api/admin/credits/adjust$ api/admin/credits-adjust.php [L,QSA]
  RewriteRule ^api/billing/plans$ api/billing/plans.php [L,QSA]
  RewriteRule ^api/generate-image$ api/generate-image.php [L,QSA]
  RewriteRule ^api/generation-history$ api/generation-history.php [L,QSA]
  RewriteRule ^api/generation-delete$ api/generation-delete.php [L,QSA]
  RewriteRule ^api/models$ api/models.php [L,QSA]
  RewriteRule ^api/admin/api-config$ api/admin/api-config.php [L,QSA]
  RewriteRule ^api/ - [R=503,L]

  # 数据文件从 dist/ 读取
  RewriteRule ^(cases\.json|style-library\.json)$ dist/$1 [L]
  RewriteRule ^images/(.*)$ dist/images/$1 [L]
  RewriteRule ^dist/ - [L]

  # 所有请求交给 index.php（检测安装锁 → 输出 SPA）
  DirectoryIndex index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.php [L,QSA]
</IfModule>
