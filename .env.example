# ============================================================
#  GPT-Image2 Gallery — 部署配置（复制为 .env 并填写）
# ============================================================
#  开箱即用：只填下面「必填」两项即可运行
# ============================================================

# ---- 数据库（必填） ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=root
DB_USER=root
DB_PASS=root

# ---- API Key（必填，生图服务商） ----
API_KEY=sk-your-api-key-here
API_BASE_URL=https://api.tokln.com/

# ---- 站点域名（可选，用于 CORS 校验） ----
APP_URL=https://your-domain.com

# ---- 功能开关（可选，不填使用默认值） ----
# GEN_COST_YUAN=0.09           # 生图单价（元/次）
# NEW_USER_FREE_COUNT=0        # 新用户免费次数
# DISABLE_REGISTER=false       # 禁止注册
# DAILY_REG_MAX=0              # 每日注册上限（0=不限）
# GLOBAL_DAILY_MAX=0           # 全站每日生图上限（0=不限）
# GLOBAL_TOTAL_MAX=0           # 全站总生图上限（0=不限）
# LOG_RETENTION_DAYS=30        # 日志保留天数
# SITE_ANNOUNCEMENT=false      # 首页公告开关
# SITE_ANNOUNCEMENT_TEXT=      # 公告内容
